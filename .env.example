# ---------- AWS ----------
# Recommended: run `aws configure --profile uk-property` and use the profile name here,
# rather than putting access keys in this file
AWS_PROFILE=uk-property
AWS_DEFAULT_REGION=eu-north-1
RAW_BUCKET=uk-property-platform-state-bucket

# ---------- Land Registry (Price Paid Data) ----------
LR_BASE_URL=http://prod.publicdata.landregistry.gov.uk.s3-website-eu-west-1.amazonaws.com
LR_MONTHLY_FILE=pp-monthly-update-new-version.csv
LR_BACKFILL_START_YEAR=1995

# ---------- ONS Postcode Directory ----------
# The download URL changes with each quarterly release. Copy the latest link from the ONS Open Geography Portal
ONS_POSTCODES_URL=https://example.com/ONSPD_LATEST_UK.zip

# ---------- EPC (Energy Performance Certificates) ----------
EPC_BASE_URL=https://epc.opendatacommunities.org/api/v1/domestic/search
EPC_EMAIL=you@example.com
EPC_API_KEY=changeme

# ---------- Airflow (local) ----------
AIRFLOW_HOME=/home/<you>/airflow-uk-property

# ---------- Later weeks (leave blank for now) ----------
# Week 2
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_JOB_ID=
# Week 3
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
# Week 4
SLACK_WEBHOOK_URL=